# Copy to .env.local and fill in. Never commit real values.

# The API (apps/api). API_URL: as this web server reaches it, for the pages' reads.
# NEXT_PUBLIC_API_URL: its public address, which the browser posts to. Unset in development,
# both are http://localhost:8000 (php artisan serve); a production server without them fails.
API_URL=
NEXT_PUBLIC_API_URL=

# Supabase project URL and its publishable key (sb_publishable_…; a legacy anon key also
# works) — Project Settings → API Keys. Both are public by design: they ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Tests only (npm run test:db / test:pages) — in .env.test.local, pointing at a SCRATCH
# project, never the one that holds real listings. Same two names as above, plus:
# SUPABASE_SECRET_KEY=   # sb_secret_… (service_role) — verifies end states and deletes test data.
#                        # Server-side only: never prefix it with NEXT_PUBLIC_.

# The site's public address (no trailing path), e.g. https://example.com. Shared links
# (WhatsApp, Instagram) need it for absolute image URLs. Server-side; set at deploy time.
# Unset: http://localhost:3000 under `next dev`; a production build stops without it.
SITE_URL=
