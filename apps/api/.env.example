# Copy to .env and fill in. Never commit real values.
APP_NAME=Princess
APP_ENV=local
# php artisan key:generate writes this
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL or MariaDB. Locally: the throwaway server on 127.0.0.1 (see the step reports).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3316
DB_DATABASE=princess_dev
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Live: the parent domain both sites share, e.g. .princess.mdneg.com, so the web app's session
# cookie reaches the API. Locally: null.
SESSION_DOMAIN=null

# The web app: where links in emails point, the browser origin allowed to call the API, and the
# domain whose requests get a session cookie (Sanctum) rather than needing a token.
PRINCESS_WEB_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# Listing photos: where the files live (outside the deployed code, so a deploy never touches
# them) and the public address of a published one. Defaults: storage/app/photos, APP_URL/photos.
PHOTOS_ROOT=
PHOTOS_PUBLIC_URL=

# On: every listing waits for a moderator until the filter has been measured (line B's launch phase).
MODERATION_LAUNCH_PHASE=true

# The visitor's real address behind the host's proxy. Leave both empty until the proxy is
# known; then name the header it writes and the addresses it sends from (comma separated).
CLIENT_IP_HEADER=
CLIENT_IP_TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Development writes every email to storage/logs/laravel.log instead of sending it.
# Live: MAIL_MAILER=smtp with the chosen provider's SMTP settings; nothing else changes.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="برينسيس"
