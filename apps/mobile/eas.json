{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:8000",
        "EXPO_PUBLIC_WEB_URL": "http://10.0.2.2:3000"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://REPLACE-WITH-THE-STAGING-API-ADDRESS",
        "EXPO_PUBLIC_WEB_URL": "https://REPLACE-WITH-THE-STAGING-SITE-ADDRESS"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://REPLACE-WITH-THE-PRODUCTION-API-ADDRESS",
        "EXPO_PUBLIC_WEB_URL": "https://REPLACE-WITH-THE-PRODUCTION-SITE-ADDRESS"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
