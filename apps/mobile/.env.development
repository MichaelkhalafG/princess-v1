# Local development (npx expo start). The Android emulator reaches this computer at 10.0.2.2
# ("localhost" inside the emulator is the emulator itself). A phone on the same Wi-Fi needs
# this computer's LAN address instead: put it in .env.development.local, which is not
# committed and wins over this file. Builds take their addresses from eas.json.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
EXPO_PUBLIC_WEB_URL=http://10.0.2.2:3000
