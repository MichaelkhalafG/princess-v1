{
  "about": [
    "One list of listing-validation cases, run by both the web app (packages/shared/tests/listing-cases.test.ts)",
    "and the API (apps/api/tests/Unit/ListingCasesTest.php and Feature/PublishTest.php). A case starts from",
    "\"base\", applies \"set\", removes the keys in \"unset\", and either passes with the \"expect\" fields, or fails",
    "with exactly \"errors\". \"rules\" are the values both implementations must carry. Change a rule here and in",
    "both, or one suite fails."
  ],
  "rules": {
    "categories": {
      "hairdressing": "كوافير وتجميل",
      "makeup": "مكياج",
      "nails": "أظافر",
      "henna": "حنّة",
      "tailoring": "خياطة وتفصيل",
      "clothes-for-sale": "بيع ملابس",
      "cooking-and-desserts": "طبخ وحلويات",
      "private-tutoring": "دروس خصوصية",
      "cleaning": "تنظيف منازل",
      "childcare": "رعاية أطفال",
      "elderly-care": "رعاية كبار السن"
    },
    "countries": {
      "EG": {
        "dial": "+20",
        "length": 10,
        "lead": "1"
      },
      "SA": {
        "dial": "+966",
        "length": 9,
        "lead": "5"
      },
      "AE": {
        "dial": "+971",
        "length": 9,
        "lead": "5"
      }
    },
    "limits": {
      "name": 40,
      "title": 80,
      "description": 600,
      "price": 40
    },
    "writable": [
      "name",
      "title",
      "category",
      "country",
      "city",
      "district",
      "description",
      "price",
      "whatsapp",
      "phone",
      "social"
    ]
  },
  "base": {
    "name": "سارة",
    "title": "تصفيف شعر",
    "category": "hairdressing",
    "country": "EG",
    "city": "القاهرة",
    "description": "تصفيف وقص في البيت",
    "whatsapp": "+201012345678"
  },
  "cases": [
    {
      "name": "the base listing",
      "set": {},
      "unset": [],
      "ok": true,
      "expect": {
        "name": "سارة",
        "title": "تصفيف شعر",
        "category": "hairdressing",
        "country": "EG",
        "city": "القاهرة",
        "district": null,
        "description": "تصفيف وقص في البيت",
        "price": null,
        "whatsapp": "+201012345678",
        "phone": null,
        "social": null
      }
    },
    {
      "name": "text is trimmed of every kind of white space JavaScript trims",
      "set": {
        "name": "\u00a0\u3000سارة\t\n",
        "title": " تصفيف شعر\u2003"
      },
      "unset": [],
      "ok": true,
      "expect": {
        "name": "سارة",
        "title": "تصفيف شعر"
      }
    },
    {
      "name": "a zero-width space is not white space, so it stays",
      "set": {
        "name": "\u200bسارة"
      },
      "unset": [],
      "ok": true,
      "expect": {
        "name": "\u200bسارة"
      }
    },
    {
      "name": "blank optional text becomes null",
      "set": {
        "district": "   ",
        "price": ""
      },
      "unset": [],
      "ok": true,
      "expect": {
        "district": null,
        "price": null
      }
    },
    {
      "name": "optional text is kept, trimmed",
      "set": {
        "district": " مدينة نصر ",
        "price": " ٥٠ للساعة "
      },
      "unset": [],
      "ok": true,
      "expect": {
        "district": "مدينة نصر",
        "price": "٥٠ للساعة"
      }
    },
    {
      "name": "every text limit, exactly",
